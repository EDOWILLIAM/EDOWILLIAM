@font-face{
    font-family: 'Montserrat';
    src: url( 'font/montserrat-variabelFont_wght.ttf');
}

body {
   padding: 0;
   margin: 0;
   font-family: 'Montserrat', sans-serif;
}

header {
     background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('img/bg.jpg');
     background-position: center;
     background-size: cover;
     background-attachment: fixed;
     width:100%
     height: 100%
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30px 60px;
}
nav img {
    width: 300px
}
nav ul {
    list-style: none;
    display: flex;
}
nav ul li {
    margin: 0px 10px
    transition: 0.5s;
}
nav ul li:hover{
     transition: translateY(-6px);
}
nav ul li a {
    color: #ffffff;
    font-size: 18px
    font-weight: 500;
    padding: 8px;
    text-decoration: mone;
}
nav ul li:hover a {
    color: #0000ff;
}
nav ul li a.active {
    border: 1px solid #0000ff;
    color: #0000ff;
}

header div {
    color: #000;
    background: rgba(255,255,255,0.5);
    border-radius: 20px;
    position: absolute;
    top: 50%
    left: 50%
    transform: translate(-50%, -50%);
    text-align: center;
    width: 50%
    padding: 20px;
}
header div h1 {
    font-size: 40px;
    margin-top: 0px;
}
header div h1 span {
    color: #0000ff;
}
header div p {
    font-size: 20px;
    font-weight: 500;
}

.button-link {
     display: inline-block;
     border: 1px solid #0000ff;
     color: #0000ff;
     font-size: 14px;
     font-weight: 500;
     padding: 12px 24px;
     text-decoration: none;
     transition: 0.5s;
}
.button-link:hover {
     color: #ffffff;
     background: #0000ff;
}
